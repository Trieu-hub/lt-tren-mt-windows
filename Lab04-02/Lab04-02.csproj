<Project Sdk="Microsoft.NET.Sdk">

  <!-- Lớp GUI (WinForms). Chỉ tham chiếu BLL, không gọi thẳng DAL hay MySQL -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>LoadSinhVien</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Thư mục DAL, BLL là project riêng, không gộp file của chúng vào project GUI -->
    <DefaultItemExcludes>$(DefaultItemExcludes);DAL\**;BLL\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="BLL\BLL.csproj" />
  </ItemGroup>

</Project>
